Screen { layout: vertical; }
#body { height: 1fr; }
#app-list, #edit-list { width: 34; border: solid $primary; }
#app-detail, #edit-detail { width: 1fr; border: solid $secondary; padding: 0 1; }
#feedback { height: 5; border: solid $accent; }
CommandBar { dock: bottom; height: 3; layout: horizontal; background: $panel; }
CommandBar #agent-status { width: 42; padding: 1 1; color: $text-muted; }
CommandBar #agent-input { width: 1fr; }
.help { color: $text-muted; padding: 0 1; }
ModalScreen { align: center middle; }
#dialog { width: 80; height: auto; max-height: 90%; border: thick $primary; background: $surface; padding: 1 2; }
#dialog Button { margin: 1 1 0 0; }
TextArea { height: 8; }
