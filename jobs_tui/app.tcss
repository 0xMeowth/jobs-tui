Screen { layout: vertical; }
#body { height: 1fr; }
#app-list, #edit-list { width: 34; border: solid $primary; }
#check-panel { height: 1fr; }
#check-body { height: 1fr; }
#check-list { width: 34; border: solid $primary; }
#check-detail { width: 1fr; border: solid $secondary; padding: 0 1; }
#check-head { padding: 0 1; }
#edit-list Horizontal { height: auto; }
#edit-list .edit-label { width: 1fr; }
#edit-list .edit-round { width: auto; color: $text-muted; }
#app-detail, #edit-detail { width: 1fr; border: solid $secondary; padding: 0 1; }
#feedback { height: 5; border: solid $accent; }
#render-info { padding: 1 2; }
CommandBar { dock: bottom; height: 3; layout: horizontal; background: $panel; }
CommandBar #agent-pane { width: 44; }
CommandBar #agent-state { width: 1fr; padding: 1 1; color: $text-muted; }
.help { color: $text-muted; padding: 0 1; }
#job-banner { background: $panel; padding: 0 1; }
ModalScreen { align: center middle; }
#dialog { width: 80; height: auto; max-height: 90%; border: thick $primary; background: $surface; padding: 1 2; }
#dialog Button { margin: 1 1 0 0; }
#dialog Label { width: 100%; }
#dialog-diff { margin-top: 1; padding: 0 1; border: solid $secondary; max-height: 12; }
TextArea { height: 8; }
#notes-text { height: 20; }
